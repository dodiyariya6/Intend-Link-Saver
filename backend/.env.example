APP_NAME="Intend Link Saver"
ENVIRONMENT=development

# Points at the `db` service in docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/intend_link_saver

# Used to sign/verify JWT access tokens issued by POST /auth/login.
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# The app's single AI provider key (Google Gemini) — required for both:
#   - The AI enrichment pipeline (POST /links/{id}/enrich): summarization,
#     tagging, and intent classification via ai_service. Without it,
#     ai_service raises AIServiceError and enrichment fails gracefully
#     (the link is preserved with status="failed").
#   - Embedding generation, which runs as the last step of enrichment.
#     Without it, embedding_service raises EmbeddingServiceError — this
#     does NOT fail the whole enrichment (the AI summary/tags/category are
#     still saved); the response just reports embedding_generated=false.
#   - The Memory Assistant (POST /search/ask).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

CORS_ORIGINS=["http://localhost:5173"]
