APP_NAME="Intend Link Saver"
ENVIRONMENT=development

# Points at the `db` service in docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/intend_link_saver

# Used to sign/verify JWT access tokens issued by POST /auth/login.
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# Required for the AI enrichment pipeline (POST /links/{id}/enrich).
# Without it, ai_service raises AIServiceError and enrichment fails
# gracefully (the link is preserved with status="failed").
ANTHROPIC_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]
